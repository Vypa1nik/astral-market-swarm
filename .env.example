# Safe local/demo defaults. Never put exchange secrets here.
DEMO_CASH=10000
DISPLAY_CURRENCY=USDT
SYMBOL=BTC/USDT
# trend-regime is validated on 4h bars. On 5m bars the 0.32% round-trip cost
# equals 2.64x ATR(14), which makes every target mathematically unprofitable.
INTERVAL=4h
# EMA200 on 4h needs a long warmup before the first signal can be trusted.
LOOKBACK=400
POLL_SECONDS=300
PORT=8080
STATE_DB=/app/state/orders.sqlite3
BINANCE_PUBLIC_BASE_URL=https://api.binance.com/api/v3
STRATEGY_PROFILE=trend-regime
